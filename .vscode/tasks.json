{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: cl.exe 生成活动文件",
            "command": "cl.exe",
            "args": [
                "/Zi",
                "/EHsc",
                "/nologo",
                "/Fe${fileDirname}/${fileBasenameNoExtension}.exe",
                "/I", "D:/vcpkg/installed/x64-windows/include",
                "/utf-8",
                "${file}",    
                "D:/vcpkg/installed/x64-windows/lib/fmt.lib",   
                "D:/vcpkg/installed/x64-windows/lib/spdlog.lib"
                
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "调试器生成的任务。"
        }
    ],
    "version": "2.0.0"
}